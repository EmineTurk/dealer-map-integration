{
  "info": {
    "_postman_id": "c924694b-8d9f-42ee-86db-9a2d88b3156f",
    "name": "Stock Service - Day 14 Resilience",
    "description": "Runs Gateway error-contract, correlation ID, write rate-limit, and read-route availability checks. Run this collection with Collection Runner because the rate-limit request repeats itself. For deterministic local verification, start the Gateway with STOCK_WRITE_RATE_PER_SECOND=1 and STOCK_WRITE_BURST_CAPACITY=2.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gatewayBaseUrl",
      "value": "http://localhost:8085"
    },
    {
      "key": "productId",
      "value": "1"
    },
    {
      "key": "storeId",
      "value": "1"
    },
    {
      "key": "lat",
      "value": "40.9901"
    },
    {
      "key": "lng",
      "value": "29.0253"
    },
    {
      "key": "rateLimitAttempt",
      "value": "0"
    },
    {
      "key": "rateLimitMaxAttempts",
      "value": "30"
    },
    {
      "key": "rateLimitWarmupMs",
      "value": "2500"
    },
    {
      "key": "rateLimitObserved",
      "value": "false"
    }
  ],
  "item": [
    {
      "name": "01 - Gateway Health and Scenario Reset",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayBaseUrl}}/actuator/health",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "actuator",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const warmupMs = Number(pm.collectionVariables.get('rateLimitWarmupMs') || '2500');",
              "setTimeout(function () {}, warmupMs);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('rateLimitAttempt', '0');",
              "pm.collectionVariables.set('rateLimitObserved', 'false');",
              "pm.test('Gateway is healthy', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('UP');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Unknown Product Error Through Gateway",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-Id",
            "value": "day14-unknown-product"
          }
        ],
        "url": {
          "raw": "{{gatewayBaseUrl}}/api/pasaj/products/999/stores?lat={{lat}}&lng={{lng}}&radius=10",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "api",
            "pasaj",
            "products",
            "999",
            "stores"
          ],
          "query": [
            {
              "key": "lat",
              "value": "{{lat}}"
            },
            {
              "key": "lng",
              "value": "{{lng}}"
            },
            {
              "key": "radius",
              "value": "10"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Stock Service ApiError passes through unchanged', function () {",
              "  pm.response.to.have.status(404);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql(404);",
              "  pm.expect(body.message).to.eql('Product not found: id=999');",
              "  pm.expect(body.timestamp).to.be.a('string');",
              "});",
              "pm.test('Client correlation ID is preserved on an error response', function () {",
              "  pm.expect(pm.response.headers.get('X-Correlation-Id')).to.eql('day14-unknown-product');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Missing Parameter Error Through Gateway",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayBaseUrl}}/api/pasaj/products/{{productId}}/stores?lat={{lat}}&lng={{lng}}",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "api",
            "pasaj",
            "products",
            "{{productId}}",
            "stores"
          ],
          "query": [
            {
              "key": "lat",
              "value": "{{lat}}"
            },
            {
              "key": "lng",
              "value": "{{lng}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Missing radius uses the shared ApiError contract', function () {",
              "  pm.response.to.have.status(400);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql(400);",
              "  pm.expect(body.message).to.eql('Missing request parameter: radius');",
              "  pm.expect(body.timestamp).to.be.a('string');",
              "});",
              "pm.test('Gateway creates a correlation ID for the error response', function () {",
              "  pm.expect(pm.response.headers.get('X-Correlation-Id')).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Malformed JSON Error Through Gateway",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"quantity\":",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{gatewayBaseUrl}}/api/pasaj/products/{{productId}}/stores/{{storeId}}/stock",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "api",
            "pasaj",
            "products",
            "{{productId}}",
            "stores",
            "{{storeId}}",
            "stock"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Malformed JSON returns a safe shared error', function () {",
              "  pm.response.to.have.status(400);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql(400);",
              "  pm.expect(body.message).to.eql('Invalid request body');",
              "  pm.expect(body.timestamp).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Unsupported Media Type Through Gateway",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "text/plain"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "quantity=4"
        },
        "url": {
          "raw": "{{gatewayBaseUrl}}/api/pasaj/products/{{productId}}/stores/{{storeId}}/stock",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "api",
            "pasaj",
            "products",
            "{{productId}}",
            "stores",
            "{{storeId}}",
            "stock"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unsupported content type returns 415 ApiError', function () {",
              "  pm.response.to.have.status(415);",
              "  const body = pm.response.json();",
              "  pm.expect(body.status).to.eql(415);",
              "  pm.expect(body.message).to.eql('Unsupported media type');",
              "  pm.expect(body.timestamp).to.be.a('string');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Rate Limited Stock Write",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": -1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{gatewayBaseUrl}}/api/pasaj/products/{{productId}}/stores/{{storeId}}/stock",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "api",
            "pasaj",
            "products",
            "{{productId}}",
            "stores",
            "{{storeId}}",
            "stock"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const attempt = Number(pm.collectionVariables.get('rateLimitAttempt') || '0') + 1;",
              "const maxAttempts = Number(pm.collectionVariables.get('rateLimitMaxAttempts') || '30');",
              "pm.collectionVariables.set('rateLimitAttempt', String(attempt));",
              "pm.test('Write is validated downstream or rejected by the Gateway', function () {",
              "  pm.expect([400, 429]).to.include(pm.response.code);",
              "});",
              "if (pm.response.code === 429) {",
              "  pm.collectionVariables.set('rateLimitObserved', 'true');",
              "}",
              "const observed = pm.collectionVariables.get('rateLimitObserved') === 'true';",
              "if (!observed && attempt < maxAttempts) {",
              "  pm.execution.setNextRequest(pm.info.requestName);",
              "} else {",
              "  pm.test('Gateway eventually returns 429 for the write burst', function () {",
              "    pm.expect(observed, 'No 429 was observed; lower the local rate-limit settings described in the collection').to.eql(true);",
              "  });",
              "  pm.execution.setNextRequest('07 - Read Route Remains Available');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Read Route Remains Available",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayBaseUrl}}/api/pasaj/products",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "api",
            "pasaj",
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Read route is not blocked by the write limiter', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.be.an('array');",
              "});",
              "pm.test('Read response still has a correlation ID', function () {",
              "  pm.expect(pm.response.headers.get('X-Correlation-Id')).to.be.a('string').and.not.empty;",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
