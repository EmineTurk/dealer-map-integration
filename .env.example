# Oracle (docker-compose)
ORACLE_PASSWORD=OraclePassword123

# store-service
STORE_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
STORE_DB_USERNAME=store_app
STORE_DB_PASSWORD=StoreApp123
STORE_SERVICE_PORT=8081

# capability-service
CAPABILITY_DB_URL=jdbc:oracle:thin:@//localhost:1521/FREEPDB1
CAPABILITY_DB_USERNAME=store_app
CAPABILITY_DB_PASSWORD=StoreApp123
CAPABILITY_SERVICE_PORT=8082
STORE_SERVICE_BASE_URL=http://localhost:8081
STORE_SERVICE_CONNECT_TIMEOUT_MS=2000
STORE_SERVICE_READ_TIMEOUT_MS=3000

# Redis (shared)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

# api-gateway
GATEWAY_PORT=8085
STOCK_SERVICE_URI=http://localhost:8080
STORE_SERVICE_URI=http://localhost:8081
CAPABILITY_SERVICE_URI=http://localhost:8082
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
STOCK_WRITE_RATE_PER_SECOND=5
STOCK_WRITE_BURST_CAPACITY=10
TRUSTED_PROXY_COUNT=0
